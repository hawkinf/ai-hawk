# ---------------------------------------------------------------------------
# ai-hawk - configuracao
# Copie para .env e preencha apenas o que for usar.
# ---------------------------------------------------------------------------

# --- Servidor -------------------------------------------------------------
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO

# --- Autenticacao da SUA API ----------------------------------------------
# Chaves que seus programas usarao em: Authorization: Bearer <chave>
# Separe multiplas chaves por virgula. Vazio = autenticacao desligada (dev local).
HAWK_API_KEYS=

# --- GUARDA DE CUSTO ------------------------------------------------------
# false = modelos pagos ficam BLOQUEADOS (HTTP 402). Mantenha assim.
ALLOW_PAID_MODELS=false

# ===========================================================================
# PROVEDORES GRATUITOS
# ===========================================================================

# --- Backends locais (custo zero absoluto: rodam na sua maquina) ---------

# Ollama. Instale em https://ollama.com e rode: ollama pull llama3.2
# Deixe vazio para desativar.
OLLAMA_BASE_URL=http://localhost:11434/v1

# Qualquer outro servico local que fale o dialeto OpenAI:
# litellm, llama.cpp --server, vLLM, LM Studio, text-generation-webui.
LITELLM_BASE_URL=
LITELLM_API_KEY=

LLAMACPP_BASE_URL=
LLAMACPP_API_KEY=

# --- Free tiers na nuvem -------------------------------------------------

# Groq - free tier, chave gratuita sem cartao: https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter - somente modelos com sufixo :free sao expostos.
# Chave gratuita: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Cerebras - free tier: https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Google AI Studio - free tier: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# ===========================================================================
# PROVEDORES PAGOS - so funcionam com ALLOW_PAID_MODELS=true
# ===========================================================================

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
